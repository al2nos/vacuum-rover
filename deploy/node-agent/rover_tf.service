[Unit]
Description=Rover TF tree (base_link->lidar static, odom->base_link 20 Hz)
After=network-online.target rover_lidar_ros.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/rover/agent.env
ExecStart=/usr/bin/env bash -c "source /opt/ros/lyrical/setup.bash && exec python3 /opt/rover-agent/lidar_ros/rover_tf.py"
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
