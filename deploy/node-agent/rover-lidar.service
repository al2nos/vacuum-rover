[Unit]
Description=Rover lidar decoder (Delta-2A/2C -> /run/rover/scan.json)
# ВАЖНО: не ставить After=multi-user.target — вместе с WantedBy=multi-user
# и rover-agent (After=rover-lidar) это даёт цикл, и systemd удаляет
# запуск агента при загрузке.
After=network.target

[Service]
EnvironmentFile=/etc/rover/agent.env
# Переинициализация драйвера UART0: применяет pinmux/pinctrl заново.
# Нужна, если пины трогали через gpiolib (gpiomon/sysfs) — иначе UART
# остаётся в режиме GPIO и не принимает байты.
ExecStartPre=-/bin/sh -c 'echo ff180000.serial > /sys/bus/platform/drivers/dw-apb-uart/unbind; sleep 1; echo ff180000.serial > /sys/bus/platform/drivers/dw-apb-uart/bind; sleep 1'
ExecStart=/opt/rover-agent/venv/bin/python /opt/rover-agent/lidar_delta.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
